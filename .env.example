# Uhakika — EXAMPLE environment configuration (PLACEHOLDERS ONLY).
#
# Copy this file to `.env` on your own machine and fill in the values locally.
# This example file must NEVER contain a real credential, token, or API key.
# The application never reads this file; it reads only the real environment.
#
# Canonical variable names ONLY (see AGENTS.md §3 and BUILD_PLAN.md §3).
# The legacy names METERLESS_API_KEY, NEMOTRON_MODEL, ZETARIS_BASE_URL are
# prohibited and must not be used.

# --- Meterless Nightshift (product AI runtime) ---
METERLESS_BASE_URL=
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=

# --- Zetaris (mandatory live data layer) ---
ZETARIS_REST_URL=
ZETARIS_ORG_ID=
ZETARIS_API_KEY=

# --- Behavior ---
# Sample mode is credential-free and works with the fields above left blank.
SAMPLE_MODE=true
MAX_EVIDENCE_RETRIES=3
